APP_NAME=Leftover
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The interface language. Ships with sq and en.
APP_LOCALE=sq
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Tirane

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite needs no setup, but the pdo_sqlite extension must be present.
# For Postgres:  DB_CONNECTION=pgsql  DB_HOST=127.0.0.1  DB_PORT=5432
#                DB_DATABASE=leftover  DB_USERNAME=...  DB_PASSWORD=...
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Getting the plan to the baker
# ---------------------------------------------------------------------------
# none     : the default. The plan is written at the hour each shop chose and
#            waits on its page. Nothing is sent, no account is needed anywhere.
# telegram : a bot pushes it. Create a bot with @BotFather, paste the token
#            here, then each shop pastes its own chat id in Settings. Free, and
#            nobody has to approve the wording.
# log      : write it to the log. For demos and tests.
#
# WhatsApp is deliberately not a server-side driver: a scheduled WhatsApp
# message needs a Meta Business account, a verified number and pre-approved
# templates. Every plan screen has a one-tap link that opens the plan in your
# own WhatsApp instead.
LEFTOVER_NOTIFY_DRIVER=none
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Defaults for a new shop
# ---------------------------------------------------------------------------
LEFTOVER_DEFAULT_LOCALE=sq
LEFTOVER_DEFAULT_TIMEZONE=Europe/Tirane
LEFTOVER_CURRENCY=EUR
LEFTOVER_OPENS_AT=06:00
LEFTOVER_CLOSES_AT=20:00
# When tomorrow's plan is written. Before the baker gets up.
LEFTOVER_PLAN_AT=04:00
